# .env.example

# ─── Database ────────────────────────────────────────────────────────
POSTGRES_USER=miragenet
POSTGRES_PASSWORD=miragenet
POSTGRES_DB=miragenet

# ─── Sensor Identity ─────────────────────────────────────────────────
MIRAGE_SENSOR_ID=mirage-01
MIRAGE_SENSOR_REGION=us-east-1

# ─── Logging ─────────────────────────────────────────────────────────
MIRAGE_LOG_LEVEL=info

# ─── Honeypot Ports (host → container) ───────────────────────────────
MIRAGE_SSH_PORT=2211
MIRAGE_HTTP_PORT=8055
MIRAGE_FTP_PORT=21272
MIRAGE_SMB_PORT=46353
MIRAGE_MYSQL_PORT=33077
MIRAGE_REDIS_PORT=44801
MIRAGE_TELNET_PORT=2323

# ─── Service Toggles ─────────────────────────────────────────────────
MIRAGE_SSH_ENABLED=true
MIRAGE_HTTP_ENABLED=true
MIRAGE_FTP_ENABLED=true
MIRAGE_SMB_ENABLED=true
MIRAGE_MYSQL_ENABLED=true
MIRAGE_REDIS_ENABLED=true
MIRAGE_TELNET_ENABLED=true

# ─── Dashboard ───────────────────────────────────────────────────────
DASHBOARD_PORT=7119
MIRAGE_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:7119

# ─── GeoIP (MaxMind) ─────────────────────────────────────────────────
GEOIP_ACCOUNT_ID=
GEOIP_LICENSE_KEY=

# ─── Self Hosting (Optional) ─────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
